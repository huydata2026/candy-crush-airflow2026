# ============================================================================
# Mẫu file cấu hình. KHÔNG điền secret thật vào file này.
#
# Cách dùng: cp .env.example .env   rồi điền các dòng đang để trống
# (mỗi dòng có ghi sẵn lệnh sinh giá trị).
# ============================================================================

# ---- Hệ thống ---------------------------------------------------------------
# Linux: đặt bằng kết quả lệnh `id -u`. macOS/Windows: giữ 50000.
AIRFLOW_UID=50000
# Cổng mở Airflow UI trên máy host
AIRFLOW_PORT=8080

# ---- Postgres (metadata DB của Airflow) -------------------------------------
POSTGRES_USER=airflow_app
POSTGRES_DB=airflow
# Sinh bằng: openssl rand -hex 24   (chỉ dùng ký tự hex để an toàn khi nằm trong URL)
POSTGRES_PASSWORD=

# ---- Tài khoản admin đăng nhập Airflow UI -----------------------------------
AIRFLOW_ADMIN_USERNAME=admin
# Sinh bằng: openssl rand -hex 16
AIRFLOW_ADMIN_PASSWORD=

# ---- Khoá của Airflow -------------------------------------------------------
# Fernet key: mã hoá connection/variable lưu trong DB. Sinh bằng 1 trong 2 lệnh:
#   openssl rand -base64 32 | tr '+/' '-_'
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# JWT secret: ký token giữa api-server và worker. Sinh bằng: openssl rand -hex 32
JWT_SECRET=
# Secret key của api-server (session/CSRF). Sinh bằng: openssl rand -hex 32
API_SECRET_KEY=

# ---- BigQuery ---------------------------------------------------------------
# Project GCP dùng cho connection `google_cloud_default`
GCP_PROJECT_ID=project-9d3c9d87-4adc-4d3b-ac1
# Đường dẫn key service account trên máy host (được mount read-only vào container)
GCP_SA_KEY_FILE=./secrets/gcp-sa.json

# ---- API xổ số (DAG xsmb_etl) -----------------------------------------------
# API key của https://xosoapi.online (đăng ký tài khoản trên trang đó để lấy key)
XSMB_API_KEY=
